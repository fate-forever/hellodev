{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fate-forever/hellodev/schemas/component-protocol-v1.schema.json",
  "title": "HelloDev Component Protocol v1 Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "component", "operationId", "action", "ok"],
  "properties": {
    "protocolVersion": {"const": "hellodev.component/v1"},
    "component": {"enum": ["hellodev@trellis", "hellodev@nocturne"]},
    "operationId": {"type": "string", "minLength": 8, "maxLength": 128},
    "action": {"type": "string", "minLength": 1, "maxLength": 128},
    "ok": {"type": "boolean"},
    "replayed": {"type": "boolean"},
    "data": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "maxLength": 1024}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}},
      "then": {"required": ["data"], "not": {"required": ["error"]}},
      "else": {"required": ["error"], "not": {"required": ["data"]}}
    }
  ]
}
